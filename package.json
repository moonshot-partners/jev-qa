{
  "name": "jev-qa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-qa": "dist/bin/jev-qa.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/snapshot.js src/snapshot.LICENSE dist/src/",
    "prepare": "npm run build"
  },
  "dependencies": {
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22"
  }
}
